    .fs-plp-card-price--sale .fs-plp-price-now { color: #c0341d; font-weight: 600; }
    .fs-plp-price-was { margin-left: 6px; color: #999; font-size: 13px; }
    .fs-plp-card-rating { margin: 4px 0 0; font-size: 12px; color: #666; }
    .fs-plp-card-stock { margin: 4px 0 0; font-size: 12px; color: #c0341d; }
    .fs-plp-card-add { margin-top: 8px; padding: 8px 12px; border: 1px solid #1a1a1a;
