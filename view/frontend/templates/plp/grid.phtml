<?php
/**
 * Light-DOM, crawlable product grid — the single-source render (Block\Plp\Grid).
 * The markup is built entirely in PlpRenderer; this template only frames it with
 * a scoped reset and the structured data, and only when there's something to
 * show. The Shadow DOM widget hydrates this markup in place — it does not
 * rebuild it.
 *
 * @var \Ahy\SmartSearchLuma\Block\Plp\Grid $block
 * @var \Magento\Framework\Escaper $escaper
 */
if (!$block->isActive()) {
    return;
}
$nativeSelector = $block->getNativeGridSelector();
?>
<?= /* @noEscape */ $block->getJsonLdHtml() ?>
<style>
    <?php if ($nativeSelector !== ''): ?>
    /* Native grid hidden — its products were emptied by CategoryListPlugin; this
       hides the empty shell + toolbar for JS-less visitors and crawlers. */
    <?= /* @noEscape (sanitised to selector-safe chars in the block) */ $nativeSelector ?> { display: none !important; }
    <?php endif; ?>

    .fs-plp { margin: 0 0 32px; color: #1a1a1a; font-family: inherit; }
    .fs-plp *, .fs-plp *::before, .fs-plp *::after { box-sizing: border-box; }
    .fs-plp a { color: inherit; text-decoration: none; }
    .fs-plp a:hover .fs-plp-card-title { text-decoration: underline; }

    .fs-plp-toolbar { display: flex; align-items: center; justify-content: space-between;
        gap: 16px; flex-wrap: wrap; margin: 0 0 16px; padding-bottom: 12px;
        border-bottom: 1px solid #e6e6e6; }
    .fs-plp-count { margin: 0; font-size: 14px; color: #555; }
