        cursor: pointer; align-self: flex-start; }
    .fs-plp-card-add[disabled] { opacity: .6; cursor: default; }

    .fs-plp-empty { margin: 24px 0; color: #666; }
    .fs-plp[aria-busy="true"] { transition: opacity .15s ease; }
    .fs-plp-chrome-host { display: block; }

    .fs-plp-pagination { display: flex; align-items: center; gap: 16px;
