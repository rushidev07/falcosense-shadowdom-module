        background: #fff; font: inherit; }

    .fs-plp-grid { list-style: none; margin: 0; padding: 0;
        display: grid; gap: 24px 16px;
        grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); }
    .fs-plp-card { display: flex; flex-direction: column; }
    .fs-plp-card-media { display: block; aspect-ratio: 1 / 1; background: #f4f4f4;
        border-radius: 6px; overflow: hidden; margin-bottom: 10px; }
    .fs-plp-card-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .fs-plp-card-title { font-size: 14px; line-height: 1.35; margin-bottom: 4px; }
